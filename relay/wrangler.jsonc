{
  "name": "necoder-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "control.necoder.com", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ControlRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlRoom"] }],
  // 部屋作成は誰でも叩ける（アカウント不要）ので、IP あたりの回数だけ絞る。
  // ペアリングは一生に数回なので 5 回/60s で実用上あたらない。上限は colo ごとの近似で、
  // 厳密な上限ではない（大量作成を鈍らせる一枚目。二枚目は POW_DIFFICULTY）。
  "ratelimits": [
    { "name": "ROOM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "limits": { "cpu_ms": 10 },
  "observability": { "enabled": false },
  // POW_DIFFICULTY は部屋作成に要求する PoW の先頭ゼロ bit 数。0 = 無効（既定）。
  // レート制限で足りなくなったらここを 20 前後へ上げるだけでホストが自動で追従する。
  "vars": { "APP_ORIGIN": "https://control.necoder.com", "POW_DIFFICULTY": "0" }
}
