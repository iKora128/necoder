{
  "name": "necoder-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "control.necoder.com", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ControlRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlRoom"] }],
  "limits": { "cpu_ms": 10 },
  "observability": { "enabled": false },
  "vars": { "APP_ORIGIN": "https://control.necoder.com" }
}
