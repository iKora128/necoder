{
  "name": "necoder-control-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-17",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ControlRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlRoom"] }],
  // 本番と同じ binding を張る（無いと limit() が undefined で 500 になる）。
  "ratelimits": [
    { "name": "ROOM_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
  ],
  "vars": { "APP_ORIGIN": "http://localhost:8791", "POW_DIFFICULTY": "0" }
}
